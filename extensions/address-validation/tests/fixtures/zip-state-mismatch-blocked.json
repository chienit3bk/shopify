{
  "payload": {
    "export": "cart-validations-generate-run",
    "target": "cart.validations.generate.run",
    "input": {
      "buyerJourney": {
        "step": "CHECKOUT_INTERACTION"
      },
      "cart": {
        "deliveryGroups": [
          {
            "deliveryAddress": {
              "address1": "350 5th Ave",
              "address2": null,
              "zip": "10118",
              "provinceCode": "CA",
              "countryCode": "US"
            }
          }
        ]
      },
      "shop": {
        "config": {
          "jsonValue": {
            "version": 1,
            "countries": [
              "US",
              "CA"
            ],
            "requireHouseNumber": true,
            "allowPoBox": false,
            "checkZipState": true
          }
        }
      }
    },
    "output": {
      "operations": [
        {
          "validationAdd": {
            "errors": [
              {
                "message": "ZIP 10118 is in NY, not CA. Check the ZIP code and the state.",
                "target": "$.cart.deliveryGroups[0].deliveryAddress.zip"
              }
            ]
          }
        }
      ]
    }
  }
}