{
  "id": {{ item.id | json }},
  "title": {{ item.title | json }},
  "url": {{ item.url | json }},
  "price": {{ item.price | json }},
  "available": {{ item.available | json }},
  "featured_image": {{ item.featured_image | image_url: width: 480 | json }},
  "tags": {{ item.tags | json }},
  "variants": [{% for variant in item.variants limit: 2 %}{"id": {{ variant.id | json }}, "available": {{ variant.available | json }}}{% unless forloop.last %},{% endunless %}{% endfor %}]
}
